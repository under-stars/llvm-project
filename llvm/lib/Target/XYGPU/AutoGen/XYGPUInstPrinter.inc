void XYGPUInstPrinter::printOprsOfInstrATOMG_RRR__BF16X2_S32(const MCInst *MI, raw_ostream &O) {
  unsigned Opcode = MI->getOpcode();
  int OprIdx = 0;
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::rd);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
  O << ", ";

  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::pu);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
  O << ", ";

  O << "[";
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::ra);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
  O << ".s32";
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::offset);
  if (MI->getOperand(OprIdx).isImm()) {
    int64_t OprVal;
    OprVal = MI->getOperand(OprIdx).getImm();
    if (OprVal >= 0)
      O << "+";
    O << formatImm(OprVal);
  } else if (MI->getOperand(OprIdx).isExpr()) {
    O << "+";
    MI->getOperand(OprIdx).getExpr()->print(O, &MAI);
  } else {
    llvm_unreachable("unexpected operand kind");
  }
  O << "]";
  O << ", ";

  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::rb);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
  O << ", ";

  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::rc);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
}

