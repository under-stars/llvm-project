void XYGPUInstPrinter::printOprsOfInstrI2F_C(const MCInst *MI, raw_ostream &O) {
  unsigned Opcode = MI->getOpcode();
  int OprIdx = 0;
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::rd);
  O << getRegisterName(MI->getOperand(OprIdx).getReg(), XYGPU::RegAltName);
  O << ", ";

  uint64_t CBankVal = 0;
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::vb_bank);
  CBankVal = MI->getOperand(OprIdx).getImm();
  O << "c[" << formatImm(CBankVal) << "][";
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::vb_offset);
  if (MI->getOperand(OprIdx).isImm()) {
    O << formatImm(MI->getOperand(OprIdx).getImm());
  } else if (MI->getOperand(OprIdx).isExpr()) {
    MI->getOperand(OprIdx).getExpr()->print(O, &MAI);
  } else {
    llvm_unreachable("unexpected operand kind");
  }
  O << "]";
  OprIdx = XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::vb_vsel);
  int CMemVSelModiVal = 0;
  CMemVSelModiVal = MI->getOperand(OprIdx).getImm();
  if (CMemVSelModiVal != 0) {
    int64_t OprVal;
    OprVal = MI->getOperand(XYGPU::getNamedOperandIdx(Opcode, XYGPU::OpName::itype)).getImm();
    if (OprVal == 0 || OprVal == 1)
      O << "." << getNameByEnum(static_cast<XYGPU::BSel>(CMemVSelModiVal));
    else if (OprVal == 2 || OprVal == 3)
      O << "." << getNameByEnum(static_cast<XYGPU::HSel>(CMemVSelModiVal));
    else
      O << "." << getNameByEnum(static_cast<XYGPU::VSel>(CMemVSelModiVal));
  }
}

