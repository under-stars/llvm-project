bool XYGPUAsmParser::parseOprsOfInstrLDGSTS_RUR__S32_U64(OperandVector &Operands, AsmOprVector &AsmOperands, const std::vector<bool> &AsmOprOmitList, SMLoc InstrLoc) {
  unsigned AsmOprIdx = 0;

  assert(AsmOprOmitList[0] == true);
  std::unique_ptr<XYGPUOperand> Opr;
  Opr = AsmOperands[AsmOprIdx]->getMemRegOffset();
  assert(Opr != nullptr);
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  XYGPUOperand::Modifiers Modis;
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  Opr = AsmOperands[AsmOprIdx]->getMemImmOffset();
  assert(Opr != nullptr);
  Operands.push_back(std::move(Opr));
  if (!AsmOperands[AsmOprIdx]->checkEmpty())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid mem operand");
  AsmOprIdx++;

  assert(AsmOprOmitList[1] == true);
  Opr = AsmOperands[AsmOprIdx]->getMemRegOffset();
  if (Opr == nullptr) {
    Operands.push_back(XYGPUOperand::createReg(XYGPU::R255, InstrLoc, InstrLoc, Modis));
  } else {
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
    Modis = Opr->getRegModis();
    int64_t ModiVal;
    ModiVal = Modis.extractADDRModeAsImm();
    if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
      ModiVal = 1;
    if (!isADDRModeMatchReg(Opr->getReg(), ModiVal))
      return Error(Opr->getStartLoc(), "reg and its addrmode not match");
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
  }
  Opr = AsmOperands[AsmOprIdx]->getMemURegOffset();
  if (Opr == nullptr) {
    Operands.push_back(XYGPUOperand::createReg(XYGPU::UR62_D, InstrLoc, InstrLoc, Modis));
  } else {
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_URegDRC));
    Modis = Opr->getRegModis();
    int64_t ModiVal;
    ModiVal = Modis.extractADDRModeAsImm();
    if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
      ModiVal = 1;
    if (!isADDRModeMatchReg(Opr->getReg(), ModiVal))
      return Error(Opr->getStartLoc(), "reg and its addrmode not match");
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
  }
  Opr = AsmOperands[AsmOprIdx]->getMemImmOffset();
  if (Opr == nullptr)
    Operands.push_back(XYGPUOperand::createIntImm(0, InstrLoc, InstrLoc));
  else
    Operands.push_back(std::move(Opr));
  if (!AsmOperands[AsmOprIdx]->checkEmpty())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid mem operand");
  AsmOprIdx++;

  if (AsmOprOmitList[2]) {
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_PredRC));
    Modis = Opr->getRegModis();
    int64_t ModiVal;
    ModiVal = Modis.extractLNotAsImm();
    if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
      ModiVal = static_cast<unsigned>(XYGPU::PModi::False);
    Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Modis.setLNot(static_cast<XYGPU::PModi>(0));
    Operands.push_back(XYGPUOperand::createIntImm(0, InstrLoc, InstrLoc));
    Operands.push_back(XYGPUOperand::createReg(XYGPU::P7, InstrLoc, InstrLoc, Modis));
  }

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
}

