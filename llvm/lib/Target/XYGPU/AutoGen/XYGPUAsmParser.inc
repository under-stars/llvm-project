bool XYGPUAsmParser::parseOprsOfInstrIADD_RC(OperandVector &Operands, AsmOprVector &AsmOperands, const std::vector<bool> &AsmOprOmitList, SMLoc InstrLoc) {
  unsigned AsmOprIdx = 0;

  assert(AsmOprOmitList[0] == true);
  std::unique_ptr<XYGPUOperand> Opr;
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  XYGPUOperand::Modifiers Modis;
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  if (AsmOprOmitList[1]) {
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_PredRC));
    Modis = Opr->getRegModis();
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Operands.push_back(XYGPUOperand::createReg(XYGPU::P7, InstrLoc, InstrLoc, Modis));
  }

  assert(AsmOprOmitList[2] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  Modis = Opr->getRegModis();
  int64_t ModiVal;
  int64_t OprVal;
  OprVal = reinterpret_cast<XYGPUOperand *>(Operands[1].get())->getImm();
  if (OprVal == 1)
    ModiVal = Modis.extractBitNotAsImm();
  else
    ModiVal = Modis.extractNegAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[3] == true);
  Modis = AsmOperands[AsmOprIdx]->getCMemModis();
  OprVal = reinterpret_cast<XYGPUOperand *>(Operands[1].get())->getImm();
  if (OprVal == 1)
    ModiVal = Modis.extractBitNotAsImm();
  else
    ModiVal = Modis.extractNegAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, AsmOperands[AsmOprIdx]->getStartLoc(), AsmOperands[AsmOprIdx]->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid operand modifier");
  Operands.push_back(AsmOperands[AsmOprIdx]->getCMemCBank());
  Operands.push_back(AsmOperands[AsmOprIdx]->getCMemCOffset());
  if (!AsmOperands[AsmOprIdx]->checkEmpty())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid mem operand");
  AsmOprIdx++;

  if (AsmOprOmitList[4]) {
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_PredRC));
    Modis = Opr->getRegModis();
    ModiVal = Modis.extractLNotAsImm();
    if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
      ModiVal = static_cast<unsigned>(XYGPU::PModi::False);
    Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Modis.setLNot(static_cast<XYGPU::PModi>(1));
    Operands.push_back(XYGPUOperand::createIntImm(1, InstrLoc, InstrLoc));
    Operands.push_back(XYGPUOperand::createReg(XYGPU::P7, InstrLoc, InstrLoc, Modis));
  }

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
}

