  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[1] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  Modis = Opr->getRegModis();
  int64_t ModiVal;
  ModiVal = Modis.extractAbsAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  ModiVal = Modis.extractHSel2AsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  ModiVal = Modis.extractNegAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[2] == true);
  Modis = AsmOperands[AsmOprIdx]->getCMemModis();
  ModiVal = Modis.extractAbsAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, AsmOperands[AsmOprIdx]->getStartLoc(), AsmOperands[AsmOprIdx]->getEndLoc()));
  ModiVal = Modis.extractHSel2AsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, AsmOperands[AsmOprIdx]->getStartLoc(), AsmOperands[AsmOprIdx]->getEndLoc()));
  ModiVal = Modis.extractNegAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, AsmOperands[AsmOprIdx]->getStartLoc(), AsmOperands[AsmOprIdx]->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid operand modifier");
  Operands.push_back(AsmOperands[AsmOprIdx]->getCMemCBank());
  Operands.push_back(AsmOperands[AsmOprIdx]->getCMemCOffset());
  if (!AsmOperands[AsmOprIdx]->checkEmpty())
    return Error(AsmOperands[AsmOprIdx]->getStartLoc(), "invalid mem operand");
  AsmOprIdx++;

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
