  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[2] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  int64_t OprVal;
  OprVal = reinterpret_cast<XYGPUOperand *>(Operands[4].get())->getImm();
  int64_t Val;
  if (OprVal == 0) {
    if (getAsmFPBinVal(Opr, APFloat::IEEEhalf(), Val))
      return true;
    AsmOprIdx++;
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    int64_t Val1;
    if (getAsmFPBinVal(Opr, APFloat::IEEEhalf(), Val1))
      return true;
    Val = (Val << 16) | Val1;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 1) {
    if (getAsmFPBinVal(Opr, APFloat::BFloat(), Val))
      return true;
    AsmOprIdx++;
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    int64_t Val1;
    if (getAsmFPBinVal(Opr, APFloat::BFloat(), Val1))
      return true;
    Val = (Val << 16) | Val1;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
