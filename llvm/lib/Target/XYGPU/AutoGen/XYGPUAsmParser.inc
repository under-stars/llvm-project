bool XYGPUAsmParser::parseOprsOfInstrATOMG_RRR__BF16X2_S32(OperandVector &Operands, AsmOprVector &AsmOperands, const std::vector<bool> &AsmOprOmitList, SMLoc InstrLoc) {
  unsigned AsmOprIdx = 0;

  assert(AsmOprOmitList[0] == true);
  std::unique_ptr<XYGPUOperand> Opr;
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  XYGPUOperand::Modifiers Modis;
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[1] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
