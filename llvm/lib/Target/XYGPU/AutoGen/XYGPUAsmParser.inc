bool XYGPUAsmParser::parseOprsOfInstrF2FP_RIR(OperandVector &Operands, AsmOprVector &AsmOperands, const std::vector<bool> &AsmOprOmitList, SMLoc InstrLoc) {
  unsigned AsmOprIdx = 0;

  assert(AsmOprOmitList[0] == true);
  std::unique_ptr<XYGPUOperand> Opr;
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  XYGPUOperand::Modifiers Modis;
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[1] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[2] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  int64_t OprVal;
  OprVal = reinterpret_cast<XYGPUOperand *>(Operands[2].get())->getImm();
  int64_t Val;
  if (OprVal == 0) {
    if (getAsmFPBinVal(Opr, APFloat::IEEEsingle(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 1) {
    if (getAsmFPBinVal(Opr, APFloat::IEEEhalf(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 2) {
    if (getAsmFPBinVal(Opr, APFloat::BFloat(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 3) {
    if (getAsmFPBinVal(Opr, APFloat::Float8E5M2(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 4) {
    if (getAsmFPBinVal(Opr, APFloat::Float8E4M3FN(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 5) {
    if (getAsmFPBinVal(Opr, APFloat::Float8E8M0FNU(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 6) {
    if (getAsmFPBinVal(Opr, APFloat::Float6E3M2FN(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 7) {
    if (getAsmFPBinVal(Opr, APFloat::Float6E2M3FN(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 8) {
    if (getAsmFPBinVal(Opr, APFloat::Float4E2M1FN(), Val))
      return true;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else {
    llvm_unreachable("Invalid operand value");
  }
  AsmOprIdx++;

  assert(AsmOprOmitList[3] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  Modis = Opr->getRegModis();
  int64_t ModiVal;
  ModiVal = Modis.extractHSelAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
}

