bool XYGPUAsmParser::parseOprsOfInstrHADD2_RC(OperandVector &Operands, AsmOprVector &AsmOperands, const std::vector<bool> &AsmOprOmitList, SMLoc InstrLoc) {
  unsigned AsmOprIdx = 0;

