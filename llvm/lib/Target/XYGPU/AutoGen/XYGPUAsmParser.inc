    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Modis.setLNot(static_cast<XYGPU::PModi>(0));
    Operands.push_back(XYGPUOperand::createIntImm(0, InstrLoc, InstrLoc));
    Operands.push_back(XYGPUOperand::createReg(XYGPU::P7, InstrLoc, InstrLoc, Modis));
  }

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
}

