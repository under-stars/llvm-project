  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_PredRC));
  Modis = Opr->getRegModis();
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[2] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  if (isZeroReg(Opr->getReg()))
    Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_RegRC));
  Modis = Opr->getRegModis();
  int64_t ModiVal;
  ModiVal = Modis.extractAbsAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  ModiVal = Modis.extractHSel2AsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  ModiVal = Modis.extractNegAsImm();
  if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
    ModiVal = 0;
  Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
  if (!Modis.checkFlags())
    return Error(Opr->getStartLoc(), "invalid operand modifier");
  Operands.push_back(std::move(Opr));
  AsmOprIdx++;

  assert(AsmOprOmitList[3] == true);
  Opr = AsmOperands[AsmOprIdx]->getSingle();
  int64_t OprVal;
  OprVal = reinterpret_cast<XYGPUOperand *>(Operands[3].get())->getImm();
  int64_t Val;
  if (OprVal == 0) {
    if (getAsmFPBinVal(Opr, APFloat::IEEEhalf(), Val))
      return true;
    AsmOprIdx++;
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    int64_t Val1;
    if (getAsmFPBinVal(Opr, APFloat::IEEEhalf(), Val1))
      return true;
    Val = (Val << 16) | Val1;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else if (OprVal == 1) {
    if (getAsmFPBinVal(Opr, APFloat::BFloat(), Val))
      return true;
    AsmOprIdx++;
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    int64_t Val1;
    if (getAsmFPBinVal(Opr, APFloat::BFloat(), Val1))
      return true;
    Val = (Val << 16) | Val1;
    Operands.push_back(XYGPUOperand::createFPBinImm(Val, Opr->getStartLoc(), Opr->getEndLoc()));
  } else {
    llvm_unreachable("Invalid operand value");
  }
  AsmOprIdx++;

  if (AsmOprOmitList[4]) {
    Opr = AsmOperands[AsmOprIdx]->getSingle();
    if (isZeroReg(Opr->getReg()))
      Opr->setReg(convertZeroRegToExactReg(Opr->getReg(), MCK_PredRC));
    Modis = Opr->getRegModis();
    ModiVal = Modis.extractLNotAsImm();
    if (ModiVal == XYGPUOperand::Modifiers::NOT_SET)
      ModiVal = static_cast<unsigned>(XYGPU::PModi::False);
    Operands.push_back(XYGPUOperand::createIntImm(ModiVal, Opr->getStartLoc(), Opr->getEndLoc()));
    if (!Modis.checkFlags())
      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Modis.setLNot(static_cast<XYGPU::PModi>(0));
    Operands.push_back(XYGPUOperand::createIntImm(0, InstrLoc, InstrLoc));
    Operands.push_back(XYGPUOperand::createReg(XYGPU::P7, InstrLoc, InstrLoc, Modis));
  }

  if (AsmOprIdx != AsmOperands.size())
    return Error(InstrLoc, "unknown instruction");
  parsePGuardModi(Operands);
  parsePGuard(Operands);
  return false;
}

