      return Error(Opr->getStartLoc(), "invalid operand modifier");
    Operands.push_back(std::move(Opr));
    AsmOprIdx++;
  } else {
    Modis.setLNot(static_cast<XYGPU::PModi>(1));
    Operands.push_back(XYGPUOperand::createIntImm(1, InstrLoc, InstrLoc));
    Operands.push_back(XYGPUOperand::createReg(XYGPU::UP7, InstrLoc, InstrLoc, Modis));
